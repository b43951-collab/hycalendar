rules_version='2';
service cloud.firestore { match /databases/{database}/documents {
  function signedIn(){return request.auth!=null;}
  function isMember(cid){return signedIn() && request.auth.uid in get(/databases/$(database)/documents/couples/$(cid)).data.members;}
  match /users/{uid}{ allow read: if signedIn(); allow write: if signedIn() && request.auth.uid==uid; }
  match /codes/{code}{ allow read: if signedIn(); allow create: if signedIn(); }
  match /couples/{cid}{
    allow read: if signedIn() && (request.auth.uid in resource.data.members || resource.data.members.size()<2);
    allow create: if signedIn() && request.resource.data.members==[request.auth.uid];
    allow update: if signedIn() && (request.auth.uid in resource.data.members || (resource.data.members.size()==1 && request.resource.data.members.size()==2 && request.resource.data.members.hasAll(resource.data.members) && request.auth.uid in request.resource.data.members && request.resource.data.code==resource.data.code));
    match /{sub}/{doc}{ allow read, write: if isMember(cid); } } } }
