rules_version='2';
service cloud.firestore { match /databases/{database}/documents {
  function signedIn(){return request.auth!=null;}
  function isAdmin(){return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));}
  function isMember(cid){return signedIn() && request.auth.uid in get(/databases/$(database)/documents/couples/$(cid)).data.members;}
  // 목록 조회(list)는 막고 문서 한 개씩 읽기(get)만 허용: 다른 사람의 가족 ID를 훑어볼 수 없게 한다
  // 내 문서이거나, 같은 가족(cid가 같음)인 사람의 문서만 읽는다. 게시판 글에 작성자 uid가 보이므로, 남의 uid로 가족 ID를 알아내 가족에 끼어드는 길을 막는다
  match /users/{uid}{
    allow get: if signedIn() && (request.auth.uid==uid
      || (resource.data.cid is string && resource.data.cid!=''
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.cid==resource.data.cid));
    allow write: if signedIn() && request.auth.uid==uid;
  }
  match /codes/{code}{ allow get: if signedIn(); allow create: if signedIn(); }
  // 전체 사용자 공용 게시판 (오류 제보 등): 로그인한 누구나 읽기·쓰기, 수정·삭제는 작성자만
  match /posts/{pid}{
    allow read: if signedIn();
    allow create: if signedIn() && request.resource.data.o==request.auth.uid;
    allow update: if signedIn() && resource.data.o==request.auth.uid;
    allow delete: if signedIn() && (resource.data.o==request.auth.uid || isAdmin());
  }
  // 서버 백업: 본인 계정만 읽고 쓴다
  match /backups/{uid}{ allow read, write: if signedIn() && request.auth.uid==uid; }
  match /admins/{aid}{ allow read: if signedIn() && request.auth.uid==aid; allow write: if false; }
  match /couples/{cid}{
    allow get: if signedIn() && (request.auth.uid in resource.data.members || resource.data.members.size()<6);
    allow create: if signedIn() && request.resource.data.members==[request.auth.uid];
    allow update: if signedIn() && (request.auth.uid in resource.data.members || (resource.data.members.size()<6 && request.resource.data.members.size()==resource.data.members.size()+1 && request.resource.data.members.hasAll(resource.data.members) && request.auth.uid in request.resource.data.members && request.resource.data.code==resource.data.code));
    match /{sub}/{doc}{ allow read, write: if sub in ['memos','uses','bals'] && isMember(cid); }
    match /posts/{pid}{
      allow read: if isMember(cid);
      allow create: if isMember(cid) && request.resource.data.o==request.auth.uid;
      allow update, delete: if isMember(cid) && resource.data.o==request.auth.uid;
    }
  }
} }
